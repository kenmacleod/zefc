my f = 666
my x = 1410
{
    # It's a bit weird that since this block has no definitions, it shares the context of its parent.
    # But that's the behavior, so we have a test for it.
    println("(1) f = ", f, ", x = ", x)
    load("stuff/package.zef")
    println("(2) f = ", f, ", x = ", x)
    import(foo)
    println("(3) f = ", f, ", x = ", x)
}
