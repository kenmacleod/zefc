# This is a Pizlscript implementation of the Richards benchmark based on the JavaScript implementation
# of Richards that was done by the V8 authors.
#
# This implementation uses more Pizlscript features
#
# Find more about the benchmark here:
#
#     http://www.cl.cam.ac.uk/~mr10/Bench.html
#
# The benchmark was originally implemented in BCPL by Martin Richards.

package Richards {
    my COUNT = 10000
    
    my EXPECTED_QUEUE_COUNT = 23246
    my EXPECTED_HOLD_COUNT = 9297
    
    my ID_IDLE = 0
    my ID_WORKER = 1
    my ID_HANDLER_A = 2
    my ID_HANDLER_B = 3
    my ID_DEVICE_A = 4
    my ID_DEVICE_B = 5
    my NUMBER_OF_IDS = 6
    
    my KIND_DEVICE = 0
    my KIND_WORK = 1
    
    my STATE_RUNNING = 0
    my STATE_RUNNABLE = 1
    my STATE_SUSPENDED = 2
    my STATE_HELD = 4
    my STATE_SUSPENDED_RUNNABLE = STATE_SUSPENDED | STATE_RUNNABLE
    my STATE_NOT_HELD = ~STATE_HELD
    
    my DATA_SIZE = 4
    
    private class Scheduler {
        readable queueCount
        readable holdCount
        my blocks
        my list
        my currentTcb
        my currentId
    
        fn ()
        {
            queueCount = 0
            holdCount = 0
            blocks = Array(NUMBER_OF_IDS)
            list = null
            currentTcb = null
            currentId = 0
        }
    
        fn addIdleTask(id, priority, queue, count)
        {
            addRunningTask(id, priority, queue, IdleTask(this, 1, count))
        }
    
        fn addWorkerTask(id, priority, queue)
        {
            addTask(id, priority, queue, WorkerTask(this, ID_HANDLER_A, 0));
        }
    
        fn addHandlerTask(id, priority, queue)
        {
            addTask(id, priority, queue, HandlerTask(this));
        }
    
        fn addDeviceTask(id, priority, queue)
        {
            addTask(id, priority, queue, DeviceTask(this));
        }
    
        fn addRunningTask(id, priority, queue, task)
        {
            addTask(id, priority, queue, task)
            currentTcb.setRunning
        }
    
        fn addTask(id, priority, queue, task)
        {
            currentTcb = TaskControlBlock(list, id, priority, queue, task)
            list = currentTcb
            blocks[id] = currentTcb
        }
    
        fn schedule
        {
            currentTcb = list
            while (currentTcb) {
                if (currentTcb.isHeldOrSuspended)
                    currentTcb = currentTcb.link
                else {
                    currentId = currentTcb.id
                    currentTcb = currentTcb.run
                }
            }
        }
    
        fn release(id)
        {
            my tcb = blocks[id]
            if (!tcb)
                return tcb
            tcb.markAsNotHeld
            if (tcb.priority > currentTcb.priority)
                return tcb
            else
                return currentTcb
        }
    
        fn holdCurrent
        {
            holdCount += 1
            currentTcb.markAsHeld
            return currentTcb.link
        }
    
        fn suspendCurrent
        {
            currentTcb.markAsSuspended
            return currentTcb
        }
    
        fn queue(packet)
        {
            my t = blocks[packet.id]
            if (!t)
                return t
            queueCount += 1
            packet.link = null
            packet.id = currentId
            return t.checkPriorityAdd(currentTcb, packet)
        }
    }
    
    private class TaskControlBlock
    {
        readable link
        readable id
        readable priority
        my queue
        my task
        my state
    
        fn (inLink, inId, inPriority, inQueue, inTask)
        {
            link = inLink
            id = inId
            priority = inPriority
            queue = inQueue
            task = inTask
            if (!queue)
                state = STATE_SUSPENDED
            else
                state = STATE_SUSPENDED_RUNNABLE
        }
    
        fn setRunning
        {
            state = STATE_RUNNING
        }
    
        fn markAsNotHeld
        {
            state &= STATE_NOT_HELD
        }
    
        fn markAsHeld
        {
            state |= STATE_HELD
        }
    
        fn isHeldOrSuspended
        {
            (state & STATE_HELD) || state == STATE_SUSPENDED
        }
    
        fn markAsSuspended
        {
            state |= STATE_SUSPENDED
        }
    
        fn markAsRunnable
        {
            state |= STATE_RUNNABLE
        }
    
        fn run
        {
            my packet
            if (state == STATE_SUSPENDED_RUNNABLE) {
                packet = queue
                queue = packet.link
                if (!queue)
                    state = STATE_RUNNING
                else
                    state = STATE_RUNNABLE
            } else
                packet = null
            return task.run(packet)
        }
    
        fn checkPriorityAdd(task, packet)
        {
            if (!queue) {
                queue = packet;
                markAsRunnable
                if (priority > task.priority)
                    return this
            } else
                queue = packet.addTo(queue)
            return task
        }
    
        fn toString "tcb { " + task.toString + "@" + state + " }"
    }
    
    private class IdleTask {
        my scheduler
        my v1
        my count
    
        fn (inScheduler, inV1, inCount)
        {
            scheduler = inScheduler
            v1 = inV1
            count = inCount
        }
    
        fn run(packet)
        {
            count -= 1
            if (!count)
                return scheduler.holdCurrent
            if (!(v1 & 1)) {
                v1 = v1 >> 1
                return scheduler.release(ID_DEVICE_A)
            } else {
                v1 = (v1 >> 1) ^ 53256
                return scheduler.release(ID_DEVICE_B)
            }
        }
    
        fn toString "IdleTask"
    }
    
    private class DeviceTask {
        my scheduler
        my v1
    
        fn (inScheduler)
        {
            scheduler = inScheduler
        }
    
        fn run(packet)
        {
            if (!packet) {
                if (!v1)
                    return scheduler.suspendCurrent
                my v = v1
                v1 = 0
                return scheduler.queue(v)
            } else {
                v1 = packet
                return scheduler.holdCurrent
            }
        }
    
        fn toString "DeviceTask"
    }
    
    private class WorkerTask {
        my scheduler
        my v1
        my v2
    
        fn (inScheduler, inV1, inV2)
        {
            scheduler = inScheduler
            v1 = inV1
            v2 = inV2
        }
    
        fn run(packet)
        {
            if (!packet)
                return scheduler.suspendCurrent
            else {
                if (v1 == ID_HANDLER_A)
                    v1 = ID_HANDLER_B
                else
                    v1 = ID_HANDLER_A
                packet.id = v1
                packet.a1 = 0
                my i = 0
                while (i < DATA_SIZE) {
                    v2 += 1
                    if (v2 > 26)
                        v2 = 1
                    packet.a2[i] = v2
                    i += 1
                }
                return scheduler.queue(packet)
            }
        }
    
        fn toString "WorkerTask"
    }
    
    private class HandlerTask {
        my scheduler
        my v1
        my v2
    
        fn (inScheduler)
        {
            scheduler = inScheduler
        }
    
        fn run(packet)
        {
            if (packet) {
                if (packet.kind == KIND_WORK)
                    v1 = packet.addTo(v1)
                else
                    v2 = packet.addTo(v2)
            }
            if (v1) {
                my count = v1.a1
                my v
                if (count < DATA_SIZE) {
                    if (v2) {
                        v = v2
                        v2 = v2.link
                        v.a1 = v1.a2[count]
                        v1.a1 = count + 1
                        return scheduler.queue(v)
                    }
                } else {
                    v = v1
                    v1 = v1.link
                    return scheduler.queue(v)
                }
            }
            return scheduler.suspendCurrent
        }
    
        fn toString "HandlerTask"
    }
    
    private class Packet {
        accessible link
        accessible id
        readable kind
        accessible a1
        readable a2
    
        fn (inLink, inId, inKind)
        {
            link = inLink
            id = inId
            kind = inKind
            a1 = 0
            a2 = Array(DATA_SIZE)
        }
    
        fn addTo(queue)
        {
            link = null
            if (!queue)
                return this
            my peek, next = queue
            while (peek = next.link)
                next = peek
            next.link = this
            return queue
        }
    
        fn toString "Packet"
    }
    
    fn runRichards
    {
        my scheduler = Scheduler()
        scheduler.addIdleTask(ID_IDLE, 0, null, COUNT)
    
        my queue = Packet(0, ID_WORKER, KIND_WORK)
        queue = Packet(queue, ID_WORKER, KIND_WORK)
        scheduler.addWorkerTask(ID_WORKER, 1000, queue)
    
        queue = Packet(0, ID_DEVICE_A, KIND_DEVICE)
        queue = Packet(queue, ID_DEVICE_A, KIND_DEVICE)
        queue = Packet(queue, ID_DEVICE_A, KIND_DEVICE)
        scheduler.addHandlerTask(ID_HANDLER_A, 2000, queue)
                                               
        queue = Packet(0, ID_DEVICE_B, KIND_DEVICE)
        queue = Packet(queue, ID_DEVICE_B, KIND_DEVICE)
        queue = Packet(queue, ID_DEVICE_B, KIND_DEVICE)
        scheduler.addHandlerTask(ID_HANDLER_B, 3000, queue)
    
        scheduler.addDeviceTask(ID_DEVICE_A, 4000, null)
        scheduler.addDeviceTask(ID_DEVICE_B, 5000, null)
    
        scheduler.schedule
    
        println("queue count = " + scheduler.queueCount.toString +
                " (expected " + EXPECTED_QUEUE_COUNT.toString + ")")
        println("hold count = " + scheduler.holdCount.toString +
                " (expected " + EXPECTED_HOLD_COUNT.toString + ")")
        if (scheduler.queueCount == EXPECTED_QUEUE_COUNT &&
            scheduler.holdCount == EXPECTED_HOLD_COUNT)
            println("SUCCESS")
        else
            error("FAILURE")
    }
}

Richards.runRichards

